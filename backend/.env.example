# ================================================
# AI Career Copilot — Environment Variables
# ================================================
# Copy this file to .env and fill in your values.
# DO NOT commit your .env file to version control.
# ================================================

# --- Application Config ---
PROJECT_NAME="AI Career Copilot"
API_V1_STR="/api/v1"
ENVIRONMENT="development"
DEBUG=true

# --- CORS Origins ---
# In production, replace with your actual frontend domain.
# Example: ["https://yourapp.vercel.app"]
BACKEND_CORS_ORIGINS=["http://localhost:5173", "http://127.0.0.1:5173", "http://localhost:3000"]

# --- Database Config ---
# Local PostgreSQL connection string
POSTGRES_SERVER=localhost
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=career_copilot
POSTGRES_PORT=5432
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/career_copilot

# --- Security Config ---
# IMPORTANT: Generate a secure random key for production:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=9a15f01eef4428df127267035418b766860d2d348a27d2c3cf8bdc6d3284ff35
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=11520

# ================================================
# AI Provider API Keys
# ================================================
# At least ONE provider is required.
# Priority order: Gemini → OpenAI → Groq
# ================================================

# Google Gemini (Free tier available)
# Get key at: https://makersuite.google.com/app/apikey
GEMINI_API_KEY=

# OpenAI (Paid)
# Get key at: https://platform.openai.com/api-keys
OPENAI_API_KEY=

# Groq — LLaMA 3.1 (Free tier, fast inference)
# Get key at: https://console.groq.com
GROQ_API_KEY=

# Google API Key (alternate Gemini key name)
GOOGLE_API_KEY=
